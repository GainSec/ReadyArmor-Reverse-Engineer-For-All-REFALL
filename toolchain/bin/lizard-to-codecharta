#!/usr/bin/env python3
import csv
import hashlib
import json
import sys
from pathlib import PurePosixPath


def usage() -> int:
    print(
        "usage: lizard-to-codecharta <lizard.csv> <output.cc.json> <project-name>",
        file=sys.stderr,
    )
    return 2


def child_folder(parent: dict, name: str) -> dict:
    for child in parent["children"]:
        if child["type"] == "Folder" and child["name"] == name:
            return child
    child = {"name": name, "type": "Folder", "attributes": {}, "children": []}
    parent["children"].append(child)
    return child


def file_node(root: dict, path: str) -> dict:
    parts = [part for part in PurePosixPath(path).parts if part not in ("", ".")]
    if not parts:
        parts = ["unknown"]
    parent = root
    for part in parts[:-1]:
        parent = child_folder(parent, part)
    name = parts[-1]
    for child in parent["children"]:
        if child["type"] == "File" and child["name"] == name:
            return child
    child = {
        "name": name,
        "type": "File",
        "attributes": {
            "rloc": 0,
            "functions": 0,
            "complexity": 0,
            "max_complexity": 0,
            "tokens": 0,
            "parameters": 0,
        },
    }
    parent["children"].append(child)
    return child


def as_int(row: dict, key: str) -> int:
    try:
        return int(float(row.get(key, "0") or 0))
    except ValueError:
        return 0


def aggregate_folder(node: dict) -> dict:
    if node["type"] == "File":
        return node["attributes"]
    totals = {
        "rloc": 0,
        "functions": 0,
        "complexity": 0,
        "max_complexity": 0,
        "tokens": 0,
        "parameters": 0,
    }
    for child in node["children"]:
        attrs = aggregate_folder(child)
        totals["rloc"] += attrs.get("rloc", 0)
        totals["functions"] += attrs.get("functions", 0)
        totals["complexity"] += attrs.get("complexity", 0)
        totals["max_complexity"] = max(
            totals["max_complexity"], attrs.get("max_complexity", 0)
        )
        totals["tokens"] += attrs.get("tokens", 0)
        totals["parameters"] = max(totals["parameters"], attrs.get("parameters", 0))
    node["attributes"] = totals
    node["children"].sort(key=lambda item: (item["type"] == "File", item["name"]))
    return totals


def main(argv: list[str]) -> int:
    if len(argv) != 4:
        return usage()

    src, dest, project = argv[1:]
    root = {"name": "root", "type": "Folder", "attributes": {}, "children": []}
    with open(src, newline="", encoding="utf-8", errors="replace") as handle:
        reader = csv.DictReader(handle)
        required = {"file", "NLOC", "CCN", "token", "PARAM"}
        if not reader.fieldnames or not required.issubset(set(reader.fieldnames)):
            print(f"{src}: unsupported lizard CSV header", file=sys.stderr)
            return 1
        for row in reader:
            path = row.get("file", "").strip()
            if not path:
                continue
            attrs = file_node(root, path)["attributes"]
            nloc = as_int(row, "NLOC")
            ccn = as_int(row, "CCN")
            attrs["rloc"] += nloc
            attrs["functions"] += 1
            attrs["complexity"] += ccn
            attrs["max_complexity"] = max(attrs["max_complexity"], ccn)
            attrs["tokens"] += as_int(row, "token")
            attrs["parameters"] = max(attrs["parameters"], as_int(row, "PARAM"))

    aggregate_folder(root)
    data = {
        "projectName": project,
        "apiVersion": "1.3",
        "nodes": [root],
        "edges": [],
        "attributeTypes": {
            "rloc": "absolute",
            "functions": "absolute",
            "complexity": "absolute",
            "max_complexity": "absolute",
            "tokens": "absolute",
            "parameters": "absolute",
        },
        "attributeDescriptors": {
            "rloc": {
                "title": "Real Lines of Code",
                "description": "Aggregated Lizard NLOC.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
            "functions": {
                "title": "Functions",
                "description": "Function count from Lizard rows.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
            "complexity": {
                "title": "Cyclomatic Complexity",
                "description": "Aggregated Lizard CCN.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
            "max_complexity": {
                "title": "Maximum Function Complexity",
                "description": "Highest Lizard CCN in this node.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
            "tokens": {
                "title": "Tokens",
                "description": "Aggregated Lizard token count.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
            "parameters": {
                "title": "Parameters",
                "description": "Maximum Lizard PARAM value.",
                "direction": -1,
                "analyzers": ["lizard"],
            },
        },
        "blacklist": [],
    }
    payload = json.dumps(data, sort_keys=True, separators=(",", ":")).encode()
    wrapped = {"checksum": hashlib.md5(payload).hexdigest(), "data": data}
    with open(dest, "w", encoding="utf-8") as handle:
        json.dump(wrapped, handle, indent=2, sort_keys=True)
        handle.write("\n")
    print(dest)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
