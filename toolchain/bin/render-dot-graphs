#!/usr/bin/env bash
set -u

GRAPH_DIR="${1:-}"
if [ -z "$GRAPH_DIR" ] || [ ! -d "$GRAPH_DIR" ]; then
  echo "usage: render-dot-graphs <graphs-dir>" >&2
  exit 2
fi

if ! command -v dot >/dev/null 2>&1; then
  echo "Graphviz dot not found; skipping DOT rendering" >&2
  exit 1
fi

if ! command -v sfdp >/dev/null 2>&1; then
  echo "Graphviz sfdp not found; skipping DOT rendering" >&2
  exit 1
fi

rendered=0
failed=0
while IFS= read -r dot_file; do
  [ -n "$dot_file" ] || continue
  base="${dot_file%.dot}"
  edge_count="$(grep -Ec -- '->|--' "$dot_file" 2>/dev/null || true)"
  case "$edge_count" in
    ''|*[!0-9]*) edge_count=0 ;;
  esac
  engine="dot"
  if [ "$edge_count" -gt 1200 ]; then
    engine="sfdp"
  fi

  if "$engine" -Tsvg "$dot_file" -o "$base.svg" &&
    "$engine" -Tpng "$dot_file" -o "$base.png"; then
    rendered=$((rendered + 1))
    printf '%s\t%s\tedges=%s\n' "$dot_file" "$engine" "$edge_count"
  else
    failed=$((failed + 1))
    printf '%s\tfailed\tengine=%s\n' "$dot_file" "$engine" >&2
  fi
done < <(find "$GRAPH_DIR" -maxdepth 1 -type f -name '*.dot' | sort)

if [ "$rendered" -eq 0 ] && [ "$failed" -eq 0 ]; then
  echo "No DOT files found in $GRAPH_DIR"
fi

[ "$failed" -eq 0 ]
