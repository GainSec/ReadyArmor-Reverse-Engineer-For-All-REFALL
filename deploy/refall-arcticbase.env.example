# REFALL-V10 ArcticBase deployment example.
# Copy to refall-arcticbase.env and adjust for the target host.

REFALL_DEPLOYMENT_MODE=local-dev
REFALL_DATA_ROOT=/var/lib/refall
REFALL_SUBJECT_ROOT=/var/lib/refall/subjects
REFALL_ARCTICBASE_DATA=/var/lib/refall/arcticbase
REFALL_LAN_BIND_IP=0.0.0.0
REFALL_ARCTICBASE_HOST=auto-lan
REFALL_ARCTICBASE_PORT=7673
REFALL_PUBLIC_BASE_URL=auto-lan
REFALL_OPENHANDS_BASE=http://127.0.0.1:8000
REFALL_OPENHANDS_API_KEY_PATH=/run/secrets/refall_openhands_api_key
REFALL_ENABLE_OPS=false
REFALL_ENABLE_OPS_COMMANDS=false
REFALL_OPS_ALLOWED_COMMANDS=status,subjects,agents,infra,start,update,closeout,context,coverage,threat-model,doctor,estimate,logs
REFALL_REPO_ROOT=/opt/refall/REFALL-V10
REFALL_ENABLE_LOOP_LAUNCH=true
REFALL_LOOP_MAX_PARALLEL=4
REFALL_LOOP_POLL_INTERVAL_S=5
REFALL_LOOP_REPORT_INTERVAL_CYCLES=10
REFALL_LOOP_STALL_CYCLES=36
REFALL_HEAD_PROVIDER=codex
REFALL_ALLOWED_HEAD_PROVIDERS=codex,claude,grok
REFALL_CODEX_COMMAND=codex
REFALL_CLAUDE_COMMAND=claude
REFALL_GROK_COMMAND=grok
REFALL_CONTEXT_MANAGER_TIMEOUT_S=1800
